---
---
<div class="pub" id="{{ entry.key }}">
  <div class="pub-meta">
    {%- if entry.abbr -%}{{ entry.abbr }}{%- elsif entry.type == 'phdthesis' -%}Thesis{%- else -%}Preprint{%- endif -%}
    <span class="pub-dot">·</span>{{ entry.year }}
    {%- if entry.award %}<span class="pub-dot">·</span><span class="pub-award">{{ entry.award }}</span>{% endif -%}
  </div>

  <div class="pub-title">{{ entry.title }}</div>

  <div class="pub-authors">
    {%- assign n = entry.author_array | size -%}
    {%- for author in entry.author_array -%}
      {%- assign is_self = false -%}
      {%- for self_last in site.scholar.last_name -%}
        {%- if author.last == self_last -%}{%- assign is_self = true -%}{%- endif -%}
      {%- endfor -%}
      {%- if is_self -%}<span class="pub-self">{{ author.first }} {{ author.last }}</span>
      {%- else -%}{{ author.first }} {{ author.last }}{%- endif -%}
      {%- unless forloop.last %}, {% endunless -%}
    {%- endfor -%}
  </div>

  {% if entry.venue_full %}<div class="pub-venue">{{ entry.venue_full }}</div>{% endif %}

  {% if entry.summary %}<p class="pub-summary">{{ entry.summary }}</p>{% endif %}

  <div class="pub-links">
    {%- if entry.arxiv %}<a href="https://arxiv.org/abs/{{ entry.arxiv }}">arXiv</a>{% endif -%}
    {%- if entry.pdf %}<a href="{{ entry.pdf }}">pdf</a>{% endif -%}
    {%- if entry.code %}<a href="{{ entry.code }}">code</a>{% endif -%}
    {%- if entry.website %}<a href="{{ entry.website }}">page</a>{% endif -%}
  </div>
</div>
