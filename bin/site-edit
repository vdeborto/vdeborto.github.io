#!/usr/bin/env python3
"""site-edit: edit vdeborto.github.io in the browser, on the rendered pages.

    bin/site-edit            start (Jekyll too, if it is not running) and open http://localhost:4100
    bin/site-edit stop       stop the editor and the Jekyll server it started
    bin/site-edit status     say whether it runs

The editor serves the site of the local Jekyll preview (port 4000) on port 4100 and adds an edit
mode to every page (bin/site-edit-ui/editor.js). Clicking a paragraph, heading, list item, caption
or table cell opens the source text that produced it; the block is redrawn in place as you type,
and saving writes the source file. Sources are found by matching the block's words against the
site's content files: Markdown pages and news, data files, the BibTeX file and, for the Block
Diffusion Rooflines book, its private text source and the files its build reads. Saving a book
file rebuilds the book (bin/build-roofline.py), and a save whose build fails is undone. Every save
can be undone; "Publish" commits the edited files and pushes them (GitHub Pages redeploys).

Only the Python standard library is used. Everything listens on 127.0.0.1 only.
"""
import html
import json
import os
import re
import shutil
import signal
import socket
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from datetime import date
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
UI = REPO / "bin" / "site-edit-ui"
BOOK_REPO = Path.home() / "code" / "diffusion-roofline"
BOOK_SRC = BOOK_REPO / "site" / "block-diffusion-rooflines.html"
BOOK_URL = "/notes/block-diffusion-rooflines-6f924020/"
PORT, JEKYLL_PORT = 4100, 4000
STATE = Path.home() / "Library" / "Application Support" / "site-edit"
LOG = STATE / "site-edit.log"
JEKYLL_LOG = STATE / "jekyll.log"
PIDFILE = STATE / "site-edit.pid"
UPLOAD_DIR = "assets/img/uploads"

# Files the editor searches, by kind. Generated files (the book's pages, note.js, _site) are left
# out on purpose: an edit there would be overwritten by the next build.
SITE_GLOBS = ["_pages/**/*.md", "_pages/**/*.html", "_news/*.md", "_posts/**/*.md", "_projects/**/*.md",
              "_data/*.yml", "_bibliography/*.bib", "_config.yml"]
BOOK_LOCAL = ["_roofline/intros.html", "_roofline/gists.html", "_roofline/cards.html", "_roofline/figures.html",
              "bin/roofline_practice.py", "bin/build-roofline.py", "bin/roofline_code.py",
              "assets/roofline/figures.js", "assets/roofline/measured.js"]
# Paths a publish may commit in the site repository (anything else that changed is listed, not committed).
PUBLISH_PREFIXES = ("_pages/", "_news/", "_posts/", "_projects/", "_data/", "_bibliography/", "_config.yml",
                    "assets/img/", "assets/pdf/", "notes/", "_roofline/", "assets/roofline/",
                    "bin/roofline_practice.py", "bin/build-roofline.py", "bin/roofline_code.py")

undo_stack = []          # (path, previous content or None if the file was new)
lock = threading.Lock()  # one save or build at a time


def log(*a):
    STATE.mkdir(parents=True, exist_ok=True)
    with LOG.open("a") as f:
        print(time.strftime("%H:%M:%S"), *a, file=f)


# ------------------------------------------------------------------------------------------- files
def book_files():
    return [BOOK_SRC] + [REPO / p for p in BOOK_LOCAL]


def site_files():
    out = []
    for g in SITE_GLOBS:
        out += sorted(REPO.glob(g))
    return [p for p in out if p.is_file()]


def is_book(path: Path) -> bool:
    return path in book_files()


def kind_of(path: Path) -> str:
    return {".md": "md", ".html": "html", ".yml": "yml", ".bib": "bib", ".py": "code", ".js": "code"}.get(path.suffix, "text")


def allowed(path: Path) -> bool:
    """The editor writes only to the files it searches and to new news items."""
    p = path.resolve()
    if p in [q.resolve() for q in book_files() + site_files()]:
        return True
    return p.parent == (REPO / "_news").resolve() and p.suffix == ".md"


def show(path: Path) -> str:
    """A path as shown to the user: relative to the site, or ~/... for the book's private source."""
    try:
        return str(path.relative_to(REPO))
    except ValueError:
        return "~/" + str(path.relative_to(Path.home()))


def resolve_shown(s: str) -> Path:
    return (Path.home() / s[2:]) if s.startswith("~/") else (REPO / s)


# ---------------------------------------------------------------------------------------- matching
MATH = re.compile(r"\\\(.*?\\\)|\\\[.*?\\\]|\$\$.*?\$\$", re.S)
WORD = re.compile(r"\w+", re.U)


def words(s: str, kind: str) -> list[str]:
    s = MATH.sub(" ", s)
    s = re.sub(r"<!--.*?-->", " ", s, flags=re.S)
    s = re.sub(r"<[^>]*>", " ", s)
    if kind == "code":
        s = s.replace("\\'", "'").replace('\\"', '"')
    s = html.unescape(s)
    if kind == "md":
        s = re.sub(r"!?\[([^\]]*)\]\([^)]*\)", r"\1", s)
    return WORD.findall(s.lower())


def best_matches(query: str, files, limit=4):
    """Find the line ranges whose words best match the query's words (F1 of word sets, refined by
    order). Each candidate is a window of 1-8 consecutive non-blank lines."""
    import difflib
    q = WORD.findall(query.lower())
    if not q:
        return []
    qs = set(q)
    cands = []
    for path in files:
        try:
            text = path.read_text()
        except (OSError, UnicodeDecodeError):
            continue
        kind = kind_of(path)
        lines = text.split("\n")
        lw = [words(l, kind) for l in lines]
        maxw = 8 if kind in ("md", "html") else 4
        for i, w in enumerate(lw):
            if not w or not (set(w) & qs):
                continue
            acc = []
            for j in range(i, min(len(lines), i + maxw)):
                if not lines[j].strip():
                    break
                acc = acc + lw[j]
                if not acc:
                    continue
                inter = len(qs & set(acc))
                rec, prec = inter / len(qs), inter / len(set(acc))
                f1 = 0 if inter == 0 else 2 * rec * prec / (rec + prec)
                cands.append((f1, rec, path, i, j, acc))
    cands.sort(key=lambda c: (-c[0], c[4] - c[3]))
    top = []
    for f1, rec, path, i, j, acc in cands[:60]:
        r = difflib.SequenceMatcher(None, q, acc, autojunk=False).ratio()
        top.append((round(0.5 * f1 + 0.5 * r, 4), rec, path, i, j))
    top.sort(key=lambda c: (-c[0], c[4] - c[3]))
    # A line that holds the whole block (a long source line with several rendered blocks) is a fallback.
    seen, out = set(), []
    for score, rec, path, i, j in top:
        key = (path, i)
        if any(p == path and not (j < a or i > b) for p, a, b in seen):
            continue
        seen.add((path, i, j))
        out.append({"score": score, "recall": round(rec, 3), "path": path, "start": i + 1, "end": j + 1})
        if len(out) == limit:
            break
    return out


def locate(page: str, text: str):
    on_book = page.startswith(BOOK_URL)
    primary = book_files() if on_book else site_files()
    found = best_matches(text, primary)
    if not found or found[0]["score"] < 0.45:
        found = best_matches(text, book_files() + site_files())
    found = [f for f in found if f["score"] >= 0.3]
    for f in found:
        lines = f["path"].read_text().split("\n")
        f["source"] = "\n".join(lines[f["start"] - 1:f["end"]])
        f["kind"] = kind_of(f["path"])
        if f["kind"] == "md" and lines and lines[0] == "---" and "---" in lines[1:]:
            if f["end"] <= lines[1:].index("---") + 2:  # inside the front matter: a YAML line
                f["kind"] = "yml"
        f["book"] = is_book(f["path"])
        f["file"] = show(f["path"])
        del f["path"]
    return found


# ------------------------------------------------------------------------------------- write, build
def build_book():
    r = subprocess.run([sys.executable, "-I", str(REPO / "bin" / "build-roofline.py")], cwd=REPO,
                       capture_output=True, text=True, timeout=300)
    out = (r.stdout + r.stderr).strip()
    return r.returncode == 0 and "PROBLEM" not in out, out


def check_syntax(path: Path, content: str):
    if path.suffix == ".py":
        try:
            compile(content, str(path), "exec")
        except SyntaxError as e:
            return f"Python syntax error, line {e.lineno}: {e.msg}"
    if path.suffix == ".js" and shutil.which("node"):
        tmp = STATE / "check.js"
        tmp.write_text(content)
        r = subprocess.run(["node", "--check", str(tmp)], capture_output=True, text=True)
        if r.returncode:
            return "JavaScript syntax error:\n" + r.stderr.strip()[-1500:]
    if path.name.endswith(".md") and content.startswith("---") and content.count("\n---") < 1:
        return "The front matter (between the two --- lines) is not closed."
    return None


def write_checked(path: Path, new_content: str, old_content):
    """Write, rebuild the book if needed; on a failed check or build, restore and report."""
    err = check_syntax(path, new_content)
    if err:
        return {"ok": False, "error": err}
    path.write_text(new_content)
    if is_book(path):
        ok, out = build_book()
        if not ok:
            if old_content is None:
                path.unlink()
            else:
                path.write_text(old_content)
            build_book()
            return {"ok": False, "error": "The book did not build, so the edit was undone:\n\n" + out[-3000:]}
    undo_stack.append((path, old_content))
    log("saved", show(path))
    return {"ok": True, "file": show(path), "book": is_book(path)}


def save(req):
    path = resolve_shown(req["file"])
    if not allowed(path):
        return {"ok": False, "error": f"The editor does not write {req['file']}."}
    with lock:
        content = path.read_text()
        lines = content.split("\n")
        if req.get("whole"):
            if content != req["old"]:
                return {"ok": False, "error": "The file changed on disk since it was opened. Reopen it."}
            new_content = req["new"]
        else:
            a, b = int(req["start"]) - 1, int(req["end"])
            if "\n".join(lines[a:b]) == req["old"]:
                new_lines = lines[:a] + req["new"].split("\n") + lines[b:]
            elif content.count(req["old"]) == 1:
                new_lines = content.replace(req["old"], req["new"]).split("\n")
            else:
                return {"ok": False, "error": "The text changed on disk since it was opened. Click the block again."}
            new_content = "\n".join(new_lines)
        if new_content == content:
            return {"ok": True, "file": req["file"], "unchanged": True}
        return write_checked(path, new_content, content)


def undo():
    with lock:
        if not undo_stack:
            return {"ok": False, "error": "Nothing to undo."}
        path, old = undo_stack.pop()
        if old is None:
            path.unlink(missing_ok=True)
        else:
            path.write_text(old)
        if is_book(path):
            ok, out = build_book()
            if not ok:
                return {"ok": False, "error": "Undone, but the book did not build:\n\n" + out[-3000:]}
        log("undid", show(path))
        return {"ok": True, "file": show(path), "left": len(undo_stack)}


def new_news(req):
    text = req.get("text", "").strip()
    if not text:
        return {"ok": False, "error": "Empty news item."}
    d = date.today().isoformat()
    slug = re.sub(r"[^a-z0-9]+", "-", re.sub(r"<[^>]+>|\[([^\]]*)\]\([^)]*\)", r"\1", text).lower()).strip("-")[:40] or "news"
    path = REPO / "_news" / f"{d}-{slug}.md"
    k = 2
    while path.exists():
        path = REPO / "_news" / f"{d}-{slug}-{k}.md"
        k += 1
    body = f"---\nlayout: post\ndate: {d}\ninline: true\nrelated_posts: false\n---\n\n{text}\n"
    with lock:
        return write_checked(path, body, None)


def upload(name: str, data: bytes):
    base = re.sub(r"[^A-Za-z0-9._-]+", "-", Path(name).name).strip("-") or "image.png"
    if Path(base).suffix.lower() not in (".png", ".jpg", ".jpeg", ".gif", ".svg", ".webp", ".pdf"):
        return {"ok": False, "error": "Only images and PDFs can be added."}
    d = REPO / UPLOAD_DIR
    d.mkdir(parents=True, exist_ok=True)
    path, stem, k = d / base, Path(base).stem, 2
    while path.exists():
        path = d / f"{stem}-{k}{Path(base).suffix}"
        k += 1
    path.write_bytes(data)
    log("uploaded", show(path))
    return {"ok": True, "url": "/" + show(path)}


# ---------------------------------------------------------------------------------------- git
def git(repo: Path, *args, check=False):
    r = subprocess.run(["git", "-C", str(repo), *args], capture_output=True, text=True)
    if check and r.returncode:
        raise RuntimeError((r.stdout + r.stderr).strip())
    return r.stdout


def changes():
    site, other = [], []
    for line in git(REPO, "status", "--porcelain", "--untracked-files=all").splitlines():
        p = line[3:].strip('"')
        (site if p.startswith(PUBLISH_PREFIXES) else other).append({"status": line[:2].strip(), "path": p})
    book = [{"status": l[:2].strip(), "path": l[3:]} for l in git(BOOK_REPO, "status", "--porcelain", "site").splitlines()] if BOOK_REPO.exists() else []
    ahead = git(BOOK_REPO, "rev-list", "--count", "@{u}..HEAD").strip() if BOOK_REPO.exists() else "0"
    return {"site": site, "other": other, "book": book, "book_ahead": int(ahead or 0), "undo": len(undo_stack)}


def publish(req):
    msg = (req.get("message") or "").strip() or "Website: edits"
    out = []
    with lock:
        try:
            ch = changes()
            if req.get("book", True) and BOOK_REPO.exists() and (ch["book"] or ch["book_ahead"]):
                if ch["book"]:
                    git(BOOK_REPO, "add", "site", check=True)
                    git(BOOK_REPO, "commit", "-q", "-m", msg, check=True)
                git(BOOK_REPO, "push", "-q", check=True)
                out.append("The book's private source is committed and pushed.")
            if ch["site"]:
                git(REPO, "add", "--", *[c["path"] for c in ch["site"]], check=True)
                git(REPO, "commit", "-q", "-m", msg, check=True)
                git(REPO, "push", "-q", check=True)
                out.append(f"The website is committed ({git(REPO, 'log', '-1', '--format=%h').strip()}) and pushed. "
                           "GitHub rebuilds it; the change is live in about 3 minutes.")
            elif not out:
                out.append("Nothing to publish.")
            undo_stack.clear()
            log("published", msg)
            return {"ok": True, "message": "\n".join(out)}
        except RuntimeError as e:
            return {"ok": False, "error": "\n".join(out + [str(e)])}


def open_in_editor(req):
    path = resolve_shown(req["file"])
    line = int(req.get("line") or 1)
    if shutil.which("emacsclient") and subprocess.run(["emacsclient", "-n", f"+{line}", str(path)], capture_output=True).returncode == 0:
        return {"ok": True}
    subprocess.Popen(["open", "-a", "Emacs", str(path)])
    return {"ok": True}


def page_mtime(url_path: str) -> float:
    p = urllib.parse.unquote(urllib.parse.urlsplit(url_path).path)
    f = REPO / "_site" / p.lstrip("/")
    if p.endswith("/") or f.is_dir():
        f = f / "index.html"
    try:
        return f.stat().st_mtime
    except OSError:
        return 0.0


def source_of_page(url_path: str):
    """The file that holds a page, for "Edit whole page"."""
    p = urllib.parse.urlsplit(url_path).path
    if p.startswith(BOOK_URL):
        return BOOK_SRC
    for f in REPO.glob("_pages/*.md"):
        m = re.search(r"^permalink:\s*(\S+)", f.read_text(), re.M)
        if m and m.group(1).rstrip("/") == p.rstrip("/"):
            return f
    m = re.match(r"^/news/announcement_\d+/?$", p)
    return None


# ------------------------------------------------------------------------------------------ jekyll
def port_open(port: int) -> bool:
    with socket.socket() as s:
        s.settimeout(0.3)
        return s.connect_ex(("127.0.0.1", port)) == 0


jekyll_proc = None


def start_jekyll():
    global jekyll_proc
    if port_open(JEKYLL_PORT):
        log("Jekyll already runs on", JEKYLL_PORT)
        return
    brew = shutil.which("brew") or "/opt/homebrew/bin/brew"
    ruby33 = subprocess.run([brew, "--prefix", "ruby@3.3"], capture_output=True, text=True).stdout.strip() + "/bin"
    gembin = subprocess.run([f"{ruby33}/ruby", "-e", "print Gem.bindir"], capture_output=True, text=True).stdout.strip()
    env = dict(os.environ, PATH=f"{ruby33}:{gembin}:/opt/homebrew/bin:/usr/bin:/bin:{os.environ.get('PATH', '')}",
               LANG="en_US.UTF-8", LC_ALL="en_US.UTF-8")
    STATE.mkdir(parents=True, exist_ok=True)
    jekyll_proc = subprocess.Popen(["bundle", "exec", "jekyll", "serve", "--livereload", "--port", str(JEKYLL_PORT)],
                                   cwd=REPO, env=env, stdout=JEKYLL_LOG.open("w"), stderr=subprocess.STDOUT,
                                   start_new_session=True)
    log("started Jekyll, pid", jekyll_proc.pid)


# ------------------------------------------------------------------------------------------- server
STARTING = """<!doctype html><meta charset="utf-8"><meta http-equiv="refresh" content="3"><title>Starting…</title>
<body style="font:16px system-ui;margin:20vh auto;max-width:34em;color:#333">
<p><b>The site is being built.</b> This page reloads by itself; the first build takes about a minute.</p>
<p style="color:#888">Log: ~/Library/Application Support/site-edit/jekyll.log</p></body>"""

INJECT = ('<link rel="stylesheet" href="/__edit/ui/editor.css">'
          '<script src="https://cdn.jsdelivr.net/npm/markdown-it@14.1.0/dist/markdown-it.min.js" defer></script>'
          '<script src="/__edit/ui/editor.js" defer></script>')


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *a, **k):
        return None


opener = urllib.request.build_opener(NoRedirect)


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *args):
        pass

    def send(self, code, body: bytes, ctype="text/html; charset=utf-8", extra=None):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        for k, v in (extra or {}).items():
            self.send_header(k, v)
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def json(self, obj, code=200):
        self.send(code, json.dumps(obj).encode(), "application/json")

    def body(self) -> bytes:
        return self.rfile.read(int(self.headers.get("Content-Length") or 0))

    # Only pages served by this editor may call its API (no other site can post to it).
    def same_origin(self) -> bool:
        origin = self.headers.get("Origin")
        return origin in (None, f"http://localhost:{PORT}", f"http://127.0.0.1:{PORT}")

    def do_HEAD(self):
        self.do_GET()

    def do_GET(self):
        u = urllib.parse.urlsplit(self.path)
        if u.path.startswith("/__edit/ui/"):
            f = UI / Path(u.path).name
            if not f.is_file():
                return self.send(404, b"not found", "text/plain")
            ctype = "text/css" if f.suffix == ".css" else "application/javascript"
            return self.send(200, f.read_bytes(), ctype + "; charset=utf-8")
        if u.path == "/__edit/mtime":
            q = urllib.parse.parse_qs(u.query)
            return self.json({"mtime": page_mtime(q.get("page", ["/"])[0])})
        if u.path == "/__edit/changes":
            return self.json(changes())
        if u.path == "/__edit/file":
            q = urllib.parse.parse_qs(u.query)
            page = q.get("page", [None])[0]
            path = source_of_page(page) if page else resolve_shown(q["file"][0])
            if not path or not allowed(path):
                return self.json({"ok": False, "error": "No source file is known for this page."})
            return self.json({"ok": True, "file": show(path), "content": path.read_text(), "kind": kind_of(path), "book": is_book(path)})
        return self.proxy()

    def do_POST(self):
        if not self.same_origin():
            return self.json({"ok": False, "error": "forbidden"}, 403)
        u = urllib.parse.urlsplit(self.path)
        try:
            if u.path == "/__edit/upload":
                q = urllib.parse.parse_qs(u.query)
                return self.json(upload(q.get("name", ["image.png"])[0], self.body()))
            req = json.loads(self.body() or b"{}")
            route = {"/__edit/locate": lambda: {"ok": True, "matches": locate(req.get("page", "/"), req.get("text", ""))},
                     "/__edit/save": lambda: save(req), "/__edit/undo": undo, "/__edit/news": lambda: new_news(req),
                     "/__edit/publish": lambda: publish(req), "/__edit/open": lambda: open_in_editor(req),
                     "/__edit/quit": quit_soon}.get(u.path)
            if not route:
                return self.json({"ok": False, "error": "unknown"}, 404)
            return self.json(route())
        except Exception as e:  # report, never crash the server
            log("error", u.path, repr(e))
            return self.json({"ok": False, "error": f"{type(e).__name__}: {e}"})

    def proxy(self):
        if not port_open(JEKYLL_PORT):
            with lock:  # Jekyll stopped (or was never started): start it, once
                if not jekyll_proc or jekyll_proc.poll() is not None:
                    start_jekyll()
            return self.send(200, STARTING.encode())
        url = f"http://127.0.0.1:{JEKYLL_PORT}{self.path}"
        try:
            r = opener.open(urllib.request.Request(url, headers={"Accept-Encoding": "identity"}), timeout=60)
            code, headers, data = r.status, r.headers, r.read()
        except urllib.error.HTTPError as e:
            code, headers, data = e.code, e.headers, e.read()
        except (urllib.error.URLError, ConnectionError, TimeoutError):
            return self.send(200, STARTING.encode())
        ctype = headers.get("Content-Type", "application/octet-stream")
        extra = {}
        if headers.get("Location"):
            extra["Location"] = re.sub(r"^https?://(localhost|127\.0\.0\.1):\d+", "", headers["Location"])
        if ctype.startswith(("text/", "application/javascript", "application/json")):
            text = data.decode("utf-8", "replace")
            text = re.sub(r"https?://(localhost|127\.0\.0\.1):%d" % JEKYLL_PORT, "", text)
            if ctype.startswith("text/html"):
                text = text.replace("</head>", INJECT + "</head>", 1) if "</head>" in text else INJECT + text
            data = text.encode()
        self.send(code, data, ctype, extra)


server = None


def quit_soon():
    threading.Timer(0.3, shutdown).start()
    return {"ok": True}


def shutdown(*_):
    log("stopping")
    if jekyll_proc and jekyll_proc.poll() is None:
        os.killpg(jekyll_proc.pid, signal.SIGTERM)
    PIDFILE.unlink(missing_ok=True)
    os._exit(0)


def serve():
    global server
    STATE.mkdir(parents=True, exist_ok=True)
    PIDFILE.write_text(str(os.getpid()))
    # Started from the app, PATH is minimal: make git, node, brew and emacsclient findable.
    os.environ["PATH"] = ":".join(["/opt/homebrew/bin", "/usr/local/bin", "/usr/bin", "/bin", os.environ.get("PATH", "")])
    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)
    start_jekyll()
    server = ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    log("serving on", PORT)
    server.serve_forever()


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "start"
    url = f"http://localhost:{PORT}/"
    if cmd == "serve":  # run in the foreground (used by start)
        return serve()
    if cmd == "stop":
        if PIDFILE.exists():
            try:
                os.kill(int(PIDFILE.read_text()), signal.SIGTERM)
                print("Stopped.")
            except ProcessLookupError:
                PIDFILE.unlink(missing_ok=True)
                print("It was not running.")
        else:
            print("It was not running.")
        return
    if cmd == "status":
        print("running at " + url if port_open(PORT) else "not running")
        return
    if cmd not in ("start", "open"):
        print(__doc__)
        return
    if not port_open(PORT):
        STATE.mkdir(parents=True, exist_ok=True)
        subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "serve"], stdout=LOG.open("a"),
                         stderr=subprocess.STDOUT, start_new_session=True, cwd=REPO)
        for _ in range(50):
            if port_open(PORT):
                break
            time.sleep(0.1)
    page = sys.argv[2] if len(sys.argv) > 2 else ""
    subprocess.run(["open", url + page.lstrip("/")])
    print("Editing at " + url)


if __name__ == "__main__":
    main()
